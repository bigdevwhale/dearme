    <!-- Onboarding -->
    <string name="onb_title">Letters to your future self</string>
    <string name="onb_text">Write now, read in a year, five or thirty. The seal holds until the day comes.</string>
    <string name="onb_how">How it works</string>
    <string name="onb_step1_title">Write a letter</string>
    <string name="onb_step1_text">Words, photos and your voice. Pick when it opens: a month, a year, thirty years, any date.</string>
    <string name="onb_step2_title">Catch random moments</string>
    <string name="onb_step2_text">At a surprise time you get two minutes to capture what\'s happening: both cameras, one line.</string>
    <string name="onb_step3_title">Break the seal</string>
    <string name="onb_step3_text">When the day comes, open it, take a \"then &amp; now\" shot and write back.</string>
    <string name="onb_name_title">Who are the letters for?</string>
    <string name="onb_name_text">Your name goes after \"Dear\". You can leave it empty.</string>
    <string name="onb_name_hint">Your name</string>
    <string name="onb_moments_text">Every day at a surprise time between 10:00 and 22:00</string>
    <string name="onb_private">Everything stays on this phone. No account, no cloud.</string>
    <string name="onb_begin">Begin</string>

